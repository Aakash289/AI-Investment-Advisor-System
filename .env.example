# Copy this file to .env and fill in the values. Never commit .env.
# Design reference: master_part1_design.md and master_part2_agents_and_build.md (Section 15).

# --- Models ---
# Get a key at https://platform.openai.com
OPENAI_API_KEY=

# Luna handles entity resolution, profile intake, news labelling and the guardrail meaning check.
MODEL_RETRIEVAL=gpt-5.6-luna
# Terra writes the synthesis narrative (one call per request).
MODEL_SYNTHESIS=gpt-5.6-terra
MODEL_GUARDRAIL=gpt-5.6-luna
# How long the quick Luna calls (news labelling, meaning check) think: low, medium, high,
# or empty for the model's default (speed, 7 October)
FAST_REASONING_EFFORT=low
# The Terra call that writes the reasoning: empty for the model's default (as before),
# or low / medium to try it faster
SYNTHESIS_REASONING_EFFORT=

# --- US filings and fundamentals ---
# SEC needs a descriptive User-Agent instead of a key: "Your Name your-email@example.com"
SEC_EDGAR_USER_AGENT=
# FMP free plan, used as the US fallback (250 calls a day).
FINANCIAL_MODELING_PREP_API_KEY=

# --- Indian fundamentals, disclosures, segments and peers ---
# Trendlyne MCP Pro (Rs 299 a month). No key: the personal URL is the access, so it is
# kept only here and never shared or printed (the app's logs blank out its token).
TRENDLYNE_MCP_URL=
# Not used; kept so older .env files still load.
TRENDLYNE_API_KEY=

# --- Prices ---
# yfinance needs no key. Massive (formerly Polygon) free plan is the US fallback.
POLYGON_API_KEY=

# --- Macro ---
# FRED needs a key. BIS, World Bank and IMF need none. MoSPI is not used (A6, not needed).
FRED_API_KEY=
MOSPI_MCP_URL=https://mcp.mospi.gov.in/

# --- News ---
# Tavily free plan (1,000 credits a month). GDELT needs no key (currently unreachable, skipped).
TAVILY_API_KEY=

# --- FX ---
# Frankfurter (with FBIL for rupee pairs) is primary and needs no key.
# FRED DEXINUS is the cross-check and uses FRED_API_KEY above.

# --- Latency limit and runaway protection (Cost and Latency Tracker) ---
# There is no dollar cap. Cost is logged per request (normal is about $0.015 to $0.025).
MAX_LATENCY_PER_REQUEST_SECONDS=120
# Stops a request stuck in a loop: LangGraph step limit and retries per model call.
MAX_GRAPH_STEPS=50
MAX_MODEL_RETRIES=2

# --- Outside calls: timeout per call and retries before the fallback source is used ---
TOOL_TIMEOUT_SECONDS=10
TOOL_RETRIES=2

# --- Free-plan quotas (tracker warns at the fraction below, then follows the skip order) ---
TAVILY_MONTHLY_CREDIT_LIMIT=1000
TRENDLYNE_MONTHLY_CALL_LIMIT=2000
TRENDLYNE_DAILY_CALL_LIMIT=400
FMP_DAILY_CALL_LIMIT=250
QUOTA_WARN_FRACTION=0.8

# --- Cache lifetimes ---
FUNDAMENTALS_CACHE_TTL_HOURS=24
QUOTE_CACHE_TTL_MINUTES=15
MACRO_CACHE_TTL_HOURS=24
SEGMENT_CACHE_TTL_DAYS=7
FX_CACHE_TTL_HOURS=24
PEER_CACHE_TTL_HOURS=24
NEWS_CACHE_TTL_MINUTES=60

# --- Storage (decision log, caches, profiles, reports) ---
DATABASE_PATH=data/invest_agent.sqlite
REPORTS_DIR=data/reports
DECISION_LOG_RETENTION_DAYS=730

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
